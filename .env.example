# Frontend (Vite) — copy to .env.local
# Note: Vite uses VITE_ prefix (not NEXT_PUBLIC_).
# Anon key may look like eyJ... (legacy JWT) or sb_publishable_... (new keys).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Supabase Edge Function secrets (set via `supabase secrets set`, NOT in Vite):
# GROQ_API_KEY=your_groq_api_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
