# Frontend (Vite) — copy to .env.local
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Opsiyonel yerel PDF servisi (PyMuPDF Markdown + OCR)
# VITE_OCR_SERVICE_URL=http://127.0.0.1:8787

# Enable Email auth in Supabase Dashboard → Authentication → Providers
# (app header: Giriş / Kayıt — cross-device group membership)

# --- AI (Supabase Edge Function secrets) ---
# Requesty router → Ling 3.1 Flash (Novita)
# https://router.requesty.ai/v1
REQUESTY_API_KEY=rqsty-sk-xxxxx
REQUESTY_BASE_URL=https://router.requesty.ai/v1
REQUESTY_MODEL=novita/ling-3.1-flash
# none = disable hybrid thinking (critical for ask latency on Ling)
REQUESTY_REASONING_EFFORT=none

# Optional aliases still read by edge code:
# AI_GATEWAY_API_KEY / MIMO_MODEL / TOKENHARBOR_*

# Never commit real keys.
